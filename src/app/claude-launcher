#!/bin/bash
# Opens the Claude project picker in a new tab of the front Ghostty window
# (or a new window if Ghostty has none open). Needs Ghostty 1.3+ AppleScript;
# falls back to a separate Ghostty window if the script is refused.
PICKER="$HOME/.local/bin/claude-project-launcher.sh"

osascript <<OSA >/dev/null 2>&1 && exit 0
tell application "Ghostty"
    activate
    set cfg to new surface configuration from {command:"$PICKER", wait after command:false}
    if (count of windows) > 0 then
        new tab in front window with configuration cfg
    else
        new window with configuration cfg
    end if
end tell
OSA

open -na "/Applications/Ghostty.app" --args -e "$PICKER"
